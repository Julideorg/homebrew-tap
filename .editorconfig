# https://editorconfig.org/
#
# shfmt reads its indentation from EditorConfig when no formatting flags are passed,
# so this is what the `shfmt --diff` check in CI enforces. Values match Homebrew's own.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
